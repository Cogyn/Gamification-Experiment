APP_NAME=Cogyn
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.koyeb.app

# Logging - stderr für Koyeb (sichtbar in Logs)
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database - SQLite für einfaches Setup
DB_CONNECTION=sqlite
# Für PostgreSQL (empfohlen für Produktion):
# DB_CONNECTION=pgsql
# DB_HOST=your-db-host
# DB_PORT=5432
# DB_DATABASE=cogyn
# DB_USERNAME=your-username
# DB_PASSWORD=your-password

# Cache & Session - File-based für Free Tier
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# OpenAI API (Required for AI features)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# Anthropic API (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-sonnet-20240229
