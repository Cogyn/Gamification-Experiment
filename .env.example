APP_NAME=Cogyn
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.koyeb.app

# Logging - stderr for Koyeb
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database - PostgreSQL (Koyeb)
DB_CONNECTION=pgsql
DB_HOST=ep-withered-sunset-aggc81nw.c-2.eu-central-1.pg.koyeb.app
DB_PORT=5432
DB_DATABASE=koyebdb
DB_USERNAME=koyeb-adm
DB_PASSWORD=your-password-here
DB_SSLMODE=require

# Cache & Session - File-based (safer for startup)
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# OpenAI API (Required for AI features)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# Anthropic API (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-sonnet-20240229
